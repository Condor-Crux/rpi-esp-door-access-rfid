# .env para la segunda instancia (baño mujeres) — puerto 8001
# Copiar al directorio rpi-door-access-rfid/ con el nombre .env.mujeres
# Iniciar con: uvicorn app.main:app --host 0.0.0.0 --port 8001 --env-file .env.mujeres

SUPER_PASSWORD=TU_SUPER_PASSWORD
VERBOSE=False
JWT_SECRET_KEY=secret_mujeres
DATABASE_URL=sqlite:///./rpi_door_access_mujeres.db

# No hay GPIO local en esta instancia (ESP32 maneja el hardware)
# Las variables de pines no se usan pero evitan errores de config
RELAY_PIN=0
BUZZER_PIN=0
LED_GREEN_PIN=0
LED_RED_PIN=0
RFID_RST_PIN=0
